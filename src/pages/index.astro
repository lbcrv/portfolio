---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { lastPush, formatDate, formatMonth } from '../lib/github';

const email = 'luisenbcarva@gmail.com';
const github = 'https://github.com/lbcrv';
const pushes = await Promise.all(projects.map((p) => lastPush(p.repo)));
const revised = formatDate(new Date());
---

<Base
  title="Luis Enrique Bustamante / Junior full-stack developer"
  description="Software engineering student in Honduras building web apps with TypeScript, React, Next.js and Node. Looking for an internship or junior role in web development."
>
  <div class="grid-bg" aria-hidden="true"></div>
  <a class="skip" href="#projects">Skip to projects</a>

  <div class="sheet">
  <header class="strip mono">
    <span>LBCRV / FILE HN-0001</span>
    <nav aria-label="Sections">
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </nav>
    <span class="hide-sm">REV {revised}</span>
  </header>

  <main>
    <section class="intro">
      <div class="plate">
        <div class="row">
          <span class="k mono">Name</span>
          <h1 class="v name">Luis Enrique Bustamante</h1>
        </div>
        <dl>
          <div class="row"><dt class="k mono">Role</dt><dd class="v">Junior full-stack developer</dd></div>
          <div class="row"><dt class="k mono">Study</dt><dd class="v">Software engineering student</dd></div>
          <div class="row"><dt class="k mono">Stack</dt><dd class="v">TypeScript, React, Next.js, Node</dd></div>
          <div class="row"><dt class="k mono">Based</dt><dd class="v">Honduras</dd></div>
          <div class="row open"><dt class="k mono">Open to</dt><dd class="v">Internships and junior roles</dd></div>
        </dl>
      </div>

      <div class="about">
        <p class="lead">
          I'm a software engineering student in Honduras, looking for an internship or junior role in web
          development. I build web apps and finish them: three of the projects below are live with public code,
          and the newest is a working demo.
        </p>

        <ul class="contact">
          <li><a class="btn" href={`mailto:${email}`}>Email <span class="mono">{email}</span></a></li>
          <li><a class="btn" href={github}>GitHub <span class="mono">github.com/lbcrv</span></a></li>
        </ul>
      </div>
    </section>

    <section id="projects" class="projects" aria-labelledby="projects-h">
      <div class="section-head mono">
        <h2 id="projects-h">Projects</h2>
        <span>{projects.length} on record</span>
      </div>

      {projects.map((p, i) => (
        <article class="entry" aria-labelledby={`p-${p.repo}`}>
          <p class="no mono" aria-hidden="true">{String(i + 1).padStart(3, '0')}</p>

          <div class="body">
            <div class="title-row">
              <h3 id={`p-${p.repo}`}>{p.name}</h3>
              <p class="meta mono"><span class="status">{p.status}</span></p>
            </div>

            <p class="summary">{p.summary}</p>

            <div class="facts">
              <div>
                <h4 class="mono">Key decisions</h4>
                <ul class="points">
                  {p.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </div>
              <div>
                <h4 class="mono">Stack</h4>
                <p>{p.stack.join(', ')}</p>
                <h4 class="mono">Languages</h4>
                <p>{p.languages}</p>
                {pushes[i] && (
                  <>
                    <h4 class="mono">Updated</h4>
                    <p>{formatMonth(pushes[i])}</p>
                  </>
                )}
              </div>
            </div>

            <p class="links">
              <a class="btn" href={p.live}>{p.status === 'Demo' ? 'Open the demo' : 'Open live build'}</a>
              {p.code === 'public' && <a class="btn" href={`${github}/${p.repo}`}>Source code</a>}
            </p>
            {p.code === 'private' && <p class="note">The code is private for now.</p>}
          </div>

          <figure class="shot">
            <Image
              src={p.image}
              alt={p.alt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 960px) 100vw, 40vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </figure>
        </article>
      ))}
    </section>

    <section id="contact" class="closing" aria-labelledby="contact-h">
      <h2 id="contact-h" class="mono">Contact</h2>
      <p>
        I'm looking for an internship or junior role in web development. Email me at{' '}
        <a href={`mailto:${email}`}>{email}</a>, or read more of my code on{' '}
        <a href={github}>GitHub</a>.
      </p>
    </section>
  </main>

  <footer class="strip mono">
    <span>END OF FILE</span>
    <span>Built with Astro</span>
  </footer>
  </div>
</Base>
